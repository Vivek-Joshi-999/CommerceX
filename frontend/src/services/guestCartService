const CART_KEY = "commercex_guest_cart";

// Get guest cart
export const getGuestCart = () => {
  const cart = localStorage.getItem(CART_KEY);

  if (!cart) {
    return [];
  }

  try {
    return JSON.parse(cart);
  } catch (error) {
    console.error("Failed to read guest cart:", error);
    return [];
  }
};

// Add product to guest cart
export const addToGuestCart = (product, quantity = 1) => {
  const cart = getGuestCart();

  const existingItem = cart.find(
    (item) => item.product._id === product._id
  );

  if (existingItem) {
    existingItem.quantity += quantity;
  } else {
    cart.push({
      product,
      quantity,
    });
  }

  localStorage.setItem(CART_KEY, JSON.stringify(cart));

  return cart;
};

// Update product quantity
export const updateGuestCartItem = (productId, quantity) => {
  const cart = getGuestCart();

  const updatedCart = cart.map((item) => {
    if (item.product._id === productId) {
      return {
        ...item,
        quantity,
      };
    }

    return item;
  });

  localStorage.setItem(CART_KEY, JSON.stringify(updatedCart));

  return updatedCart;
};

// Remove product
export const removeFromGuestCart = (productId) => {
  const cart = getGuestCart();

  const updatedCart = cart.filter(
    (item) => item.product._id !== productId
  );

  localStorage.setItem(CART_KEY, JSON.stringify(updatedCart));

  return updatedCart;
};

// Clear guest cart
export const clearGuestCart = () => {
  localStorage.removeItem(CART_KEY);
};